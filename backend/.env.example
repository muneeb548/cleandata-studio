# Copy this file to .env and adjust as needed. All values are optional.

# Largest accepted upload, in MB (default 100). Larger files are rejected with a clear error.
MAX_UPLOAD_MB=100
# Inactive sessions (and their data) are deleted after this many minutes.
SESSION_TTL_MINUTES=30
# At most this many datasets are kept in memory at once; the least recently used is removed.
MAX_SESSIONS=10
# Undo history: maximum number of stored steps, and memory budget (MB) for older steps.
# The original upload, the current data and the step before it are always kept.
MAX_HISTORY_SNAPSHOTS=20
MAX_HISTORY_MEMORY_MB=1024
MAX_PAGE_SIZE=200
# How text is kept in memory. auto (default): Apache Arrow (pyarrow) when installed, which needs
# several times less memory for large files. python: one Python object per cell (old behaviour).
STRING_STORAGE=auto
RATE_LIMIT_PER_MINUTE=240
UPLOAD_LIMIT_PER_MINUTE=20
# Comma-separated list of frontend origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# Production settings (see DEPLOYMENT.md). Safe to leave unset for local use.
# ---------------------------------------------------------------------------
# development (default) or production. Production: API docs off, HSTS on, config checked at startup.
ENVIRONMENT=development
# Serve the built website from this server (path to frontend/dist). Empty = API only.
FRONTEND_DIST=
# Interactive docs at /docs (default: on in development, off in production).
ENABLE_API_DOCS=
# Seconds for the Strict-Transport-Security header (default 31536000 in production, 0 otherwise).
HSTS_SECONDS=
# Redirect http:// to https:// using the hosting proxy's X-Forwarded-Proto header.
FORCE_HTTPS=false
# Header with the visitor's IP set by your hosting proxy (e.g. X-Real-IP). Used only for rate limiting.
# Leave empty unless the app can ONLY be reached through that proxy.
CLIENT_IP_HEADER=
# Memory budget for all datasets together, in MB (0 = no limit).
MAX_TOTAL_MEMORY_MB=0
# A dataset used within this many seconds is never removed to make room; the new upload gets "server busy".
SESSION_PROTECT_SECONDS=0
# Uploads processed at the same time (0 = unlimited).
MAX_CONCURRENT_UPLOADS=0
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# AI assistant (optional). See README "AI assistant".
# ---------------------------------------------------------------------------
# off (default) | ollama (free, runs on this computer, data stays here) | anthropic (Claude API, paid, cloud)
AI_PROVIDER=off
# Empty = default for the provider: qwen2.5:3b for ollama, claude-haiku-5-5 for anthropic.
AI_MODEL=
# Where Ollama listens (default http://localhost:11434).
OLLAMA_URL=http://localhost:11434
# Only for AI_PROVIDER=anthropic. Never commit your real key.
ANTHROPIC_API_KEY=
# true: also share up to AI_MAX_VALUES example values per column (needed for "Suggest with AI" in Map values).
# false: only column names, types and counts are shared.
AI_SEND_VALUES=true
AI_MAX_VALUES=20
# Seconds to wait for an answer (a local model on a laptop CPU can be slow).
AI_TIMEOUT_SECONDS=180
# AI requests allowed per uploaded file (0 = unlimited). Protects a paid API key on a public site.
AI_MAX_CALLS_PER_SESSION=30
