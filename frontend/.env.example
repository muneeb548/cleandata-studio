# Optional. Leave empty during local development (the Vite dev server proxies /api to port 8000).
# Set it when the frontend and backend are hosted on different domains, e.g. https://api.example.com
VITE_API_BASE_URL=

# Optional. Request timeout in milliseconds (default 120000). Uploads have no timeout.
VITE_API_TIMEOUT_MS=120000

# Never put secrets here: every VITE_* value is embedded in the public JavaScript bundle.

# Optional contact details shown on the Contact page. If empty, the page says contact is not configured.
VITE_CONTACT_EMAIL=
VITE_GITHUB_URL=

# Public site URL (no trailing slash). Used at BUILD time for canonical links, robots.txt and
# sitemap.xml — set it to your real https:// address before `npm run build` for production.
VITE_SITE_URL=http://localhost:5173
