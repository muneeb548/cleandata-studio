# Recommended variables for a small public deployment (one container, ~2 GB RAM peak).
# Paste these into your hosting platform's "Variables" / "Environment" page.
# They are NOT secrets — CleanData Studio needs no API keys or passwords.
# Never commit a real .env file.

ENVIRONMENT=production
# The Docker image sets FRONTEND_DIST=/app/frontend_dist, so the website and API share one origin.

# --- Limits (see DEPLOYMENT.md "Capacity and cost") ---
MAX_UPLOAD_MB=25
SESSION_TTL_MINUTES=30
MAX_SESSIONS=8
MAX_TOTAL_MEMORY_MB=1024
MAX_HISTORY_MEMORY_MB=256
MAX_HISTORY_SNAPSHOTS=20
SESSION_PROTECT_SECONDS=600
MAX_CONCURRENT_UPLOADS=2
MAX_PAGE_SIZE=200
RATE_LIMIT_PER_MINUTE=240
UPLOAD_LIMIT_PER_MINUTE=10

# --- HTTPS and proxy ---
FORCE_HTTPS=true
HSTS_SECONDS=31536000
# Railway's edge sets X-Real-IP (see DEPLOYMENT.md). Other platforms: check their docs or leave empty.
CLIENT_IP_HEADER=X-Real-IP

# --- Only if the website is hosted on a DIFFERENT domain than the API ---
# CORS_ORIGINS=https://www.your-domain.com

LOG_LEVEL=INFO

# --- Build-time (public) values for the website ---
# On Railway, add these as variables too; the Dockerfile reads them as build arguments.
# VITE_SITE_URL=https://your-domain.com      (default on Railway: https://<generated>.up.railway.app)
# VITE_CONTACT_EMAIL=you@example.com          (shown publicly on the Contact page)
# VITE_GITHUB_URL=https://github.com/you/cleandata-studio
